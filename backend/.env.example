ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_REGEX=
DATABASE_URL=sqlite:///./local.db

# LLM providers, tried in order (free tiers). Keys: https://aistudio.google.com/apikey , https://console.groq.com/keys
LLM_PROVIDERS=gemini,groq
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides
# GEMINI_MODEL_FAST=gemini-flash-latest
# GEMINI_MODEL_SMART=gemini-flash-latest
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_SMART=openai/gpt-oss-120b
# Optional paid provider (add "anthropic" to LLM_PROVIDERS to use)
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

DAILY_LLM_LIMIT=50
MONTHLY_LLM_BUDGET=20

ADMIN_EMAILS=
